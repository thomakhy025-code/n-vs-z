rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function whole(n) {
      return n is int || (n is float && n == int(n));
    }
    function okTime(n) {
      return (n is int || n is float) && n >= 0 && n <= 86400;
    }
    function knownFavorite(id) {
      return id == ''
        || id == 'sword' || id == 'archer' || id == 'shield' || id == 'saber'
        || id == 'lancer' || id == 'berserker' || id == 'horse'
        || id == 'suicide' || id == 'assassin' || id == 'heal' || id == 'level';
    }
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'unlocked', 'cleared', 'diamonds', 'saber_skin', 'saber_worn',
          'sheet_owned', 'sheet_worn', 'diamond_paid', 'code_paid', 'updated'
        ])
        && whole(request.resource.data.unlocked)
        && request.resource.data.unlocked >= 1
        && request.resource.data.unlocked <= 10
        && whole(request.resource.data.cleared)
        && request.resource.data.cleared >= 0
        && request.resource.data.cleared <= 10
        && whole(request.resource.data.diamonds)
        && request.resource.data.diamonds >= 0
        && request.resource.data.diamonds <= 200000000
        && whole(request.resource.data.diamond_paid)
        && request.resource.data.diamond_paid >= 1
        && request.resource.data.diamond_paid <= 10
        && request.resource.data.saber_skin is bool
        && request.resource.data.code_paid is bool
        && request.resource.data.saber_worn is string
        && request.resource.data.saber_worn.size() <= 16
        && request.resource.data.sheet_owned is string
        && request.resource.data.sheet_owned.size() <= 240
        && request.resource.data.sheet_worn is string
        && request.resource.data.sheet_worn.size() <= 240
        && request.resource.data.updated is timestamp;
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'cleared', 'clear_time', 'favorite', 'favorite_skin',
          'hero_sheet', 'saber_worn', 'best_rank', 'updated'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9]{2,16}$')
        && whole(request.resource.data.cleared)
        && request.resource.data.cleared >= 0
        && request.resource.data.cleared <= 10
        && okTime(request.resource.data.clear_time)
        && request.resource.data.favorite is string
        && knownFavorite(request.resource.data.favorite)
        && request.resource.data.favorite_skin is string
        && request.resource.data.favorite_skin.size() <= 16
        && (request.resource.data.favorite_skin == ''
          || request.resource.data.favorite_skin == 'sheet'
          || request.resource.data.favorite_skin == 'navy')
        && (request.resource.data.favorite != ''
          || request.resource.data.favorite_skin == '')
        && (request.resource.data.favorite_skin != 'navy'
          || request.resource.data.favorite == 'saber')
        && request.resource.data.hero_sheet is bool
        && request.resource.data.saber_worn is string
        && (request.resource.data.saber_worn == 'none'
          || request.resource.data.saber_worn == 'navy')
        && whole(request.resource.data.best_rank)
        && request.resource.data.best_rank >= 0
        && request.resource.data.best_rank <= 100000
        && request.resource.data.updated is timestamp;
      allow delete: if false;
    }
  }
}
